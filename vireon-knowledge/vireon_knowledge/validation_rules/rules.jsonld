{
    "@context": {
        "vk": "https://saadimalik1.github.io/vireon-nvos/knowledge/rules#"
    },
    "@id": "vk:ValidationRules",
    "rules": [
        {
            "@id": "vk:Rule:StationarityForWelch",
            "target_method": "vk:Method:Welch",
            "condition": "signal.stationarity == True",
            "violation_severity": "HIGH",
            "recommendation": "vk:Method:Multitaper",
            "message": "Welch's method is inappropriate for highly non-stationary signals. Use Multitaper or Wavelet analysis."
        },
        {
            "@id": "vk:Rule:RankDeficiencyForICA",
            "target_method": "vk:Method:ICA",
            "condition": "signal.rank < signal.num_channels",
            "violation_severity": "CRITICAL",
            "recommendation": "vk:Method:PCA_Dimension_Reduction",
            "message": "ICA fails on rank-deficient data (e.g. after average referencing). Reduce dimensionality first."
        },
        {
            "@id": "vk:Rule:BalancedClassesForCSP",
            "target_method": "vk:Method:CSP",
            "condition": "dataset.class_balance_ratio < 0.2",
            "violation_severity": "HIGH",
            "recommendation": "vk:Method:Class_Weighting",
            "message": "Common Spatial Patterns is highly sensitive to class imbalance. Ensure balanced classes or use class weighting."
        },
        {
            "@id": "vk:Rule:StationarityForFFT",
            "target_method": "vk:Method:FFT",
            "condition": "signal.stationarity == True",
            "violation_severity": "MEDIUM",
            "recommendation": "vk:Method:STFT",
            "message": "FFT assumes stationarity; use STFT for non-stationary signals."
        },
        {
            "@id": "vk:Rule:WindowLengthForSTFT",
            "target_method": "vk:Method:STFT",
            "condition": "signal.length >= stft.window_length",
            "violation_severity": "HIGH",
            "recommendation": null,
            "message": "STFT window length must not exceed signal length."
        },
        {
            "@id": "vk:Rule:ScaleRangeForWavelet",
            "target_method": "vk:Method:Wavelet",
            "condition": "wavelet.max_scale <= signal.length // 2",
            "violation_severity": "MEDIUM",
            "recommendation": null,
            "message": "Wavelet maximum scale must not exceed half the signal length."
        },
        {
            "@id": "vk:Rule:TaperCountForMultitaper",
            "target_method": "vk:Method:Multitaper",
            "condition": "multitaper.n_tapers <= 2 * multitaper.time_bandwidth - 1",
            "violation_severity": "LOW",
            "recommendation": null,
            "message": "Number of tapers should not exceed 2*TW-1 for DPSS-based multitaper."
        },
        {
            "@id": "vk:Rule:FilterLengthForFIR",
            "target_method": "vk:Method:FIR",
            "condition": "signal.length >= fir.filter_order * 3",
            "violation_severity": "MEDIUM",
            "recommendation": "vk:Method:IIR",
            "message": "FIR filter requires at least 3x filter order samples for stable convolution."
        },
        {
            "@id": "vk:Rule:FilterStabilityForIIR",
            "target_method": "vk:Method:IIR",
            "condition": "iir.is_stable == True",
            "violation_severity": "HIGH",
            "recommendation": "vk:Method:FIR",
            "message": "IIR filter poles must be inside the unit circle for stability."
        },
        {
            "@id": "vk:Rule:BandOverlapForFBCSP",
            "target_method": "vk:Method:FBCSP",
            "condition": "fbcsp.bands_non_overlapping == True",
            "violation_severity": "LOW",
            "recommendation": null,
            "message": "FBCSP frequency bands should not overlap to avoid redundant features."
        },
        {
            "@id": "vk:Rule:ERPForXDAWN",
            "target_method": "vk:Method:XDAWN",
            "condition": "dataset.has_event_markers == True",
            "violation_severity": "HIGH",
            "recommendation": null,
            "message": "xDAWN requires event markers for ERP-based spatial filtering."
        },
        {
            "@id": "vk:Rule:PositiveDefinitenessForRiemannian",
            "target_method": "vk:Method:RiemannianMDM",
            "condition": "covariance.is_positive_definite == True",
            "violation_severity": "CRITICAL",
            "recommendation": "vk:Method:RegularizedCovariance",
            "message": "Riemannian geometry requires positive-definite covariance matrices. Use regularization (OAS, Ledoit-Wolf)."
        },
        {
            "@id": "vk:Rule:SiftingStopForEMD",
            "target_method": "vk:Method:EMD",
            "condition": "emd.sifting_converged == True",
            "violation_severity": "MEDIUM",
            "recommendation": null,
            "message": "EMD sifting must converge (SD criterion < 0.3) before extracting next IMF."
        },
        {
            "@id": "vk:Rule:ChannelCountForBeamforming",
            "target_method": "vk:Method:Beamforming",
            "condition": "signal.num_channels >= 32",
            "violation_severity": "MEDIUM",
            "recommendation": null,
            "message": "Source localization via beamforming requires at least 32 channels for reliable results."
        },
        {
            "@id": "vk:Rule:ForwardModelForSourceLocalization",
            "target_method": "vk:Method:SourceLocalization",
            "condition": "dataset.has_forward_model == True",
            "violation_severity": "CRITICAL",
            "recommendation": null,
            "message": "Source localization requires a forward head model (BEM or FEM)."
        },
        {
            "@id": "vk:Rule:PhaseWrappingForPLV",
            "target_method": "vk:Method:PLV",
            "condition": "phase.is_wrapped == True",
            "violation_severity": "LOW",
            "recommendation": null,
            "message": "Phase values must be wrapped to [-pi, pi] before computing Phase Locking Value."
        },
        {
            "@id": "vk:Rule:VolumeConductionForWPLI",
            "target_method": "vk:Method:WPLI",
            "condition": "connectivity.zero_lag_tested == True",
            "violation_severity": "LOW",
            "recommendation": null,
            "message": "wPLI should be tested for volume conduction sensitivity (zero-lag phase differences)."
        },
        {
            "@id": "vk:Rule:StationarityForTransferEntropy",
            "target_method": "vk:Method:TransferEntropy",
            "condition": "signal.stationarity == True",
            "violation_severity": "MEDIUM",
            "recommendation": "vk:Method:DynamicConditionalCorrelation",
            "message": "Transfer entropy assumes stationarity for Granger-type causality inference."
        },
        {
            "@id": "vk:Rule:MinimumEpochsForEEGNet",
            "target_method": "vk:Method:EEGNet",
            "condition": "dataset.n_epochs >= 100",
            "violation_severity": "HIGH",
            "recommendation": "vk:Method:CSP",
            "message": "Deep learning (EEGNet) requires at least 100 epochs. Use CSP+LDA for smaller datasets."
        },
        {
            "@id": "vk:Rule:MinimumEpochsForDeepConvNet",
            "target_method": "vk:Method:DeepConvNet",
            "condition": "dataset.n_epochs >= 100",
            "violation_severity": "HIGH",
            "recommendation": "vk:Method:CSP",
            "message": "Deep learning (DeepConvNet) requires at least 100 epochs. Use CSP+LDA for smaller datasets."
        }
    ]
}
