+    def _load_sleep_edf(self, subject: int, info: Dict) -> Dict[str, Any]:
+        """Load Sleep-EDF dataset via MNE."""
+        files = mne.datasets.sleep_physionet.age.fetch_data(
+            subjects=[subject], recording=[1], on_missing="warn"
+        )
+        raw = mne.io.read_raw_edf(files[0][0], preload=True, verbose=False)
+        data_arr = raw.get_data()
+        n_channels, n_samples = data_arr.shape
+        sfreq = raw.info["sfreq"]
+
+        epoch_samples = int(30 * sfreq)
+        n_epochs = data_arr.shape[1] // epoch_samples
+        data = data_arr[:, :n_epochs * epoch_samples].reshape(
+            n_channels, n_epochs, epoch_samples
+        ).swapaxes(0, 1)
+        labels = np.zeros(n_epochs, dtype=int)
+        sha256_checksum = hashlib.sha256(data.tobytes()).hexdigest()
+
+        return {
+            "name": info["name"],
+            "data": data,
+            "labels": labels,
+            "checksum": sha256_checksum,
+            "key": "sleep_edf",
+            "source": "real",
+            "fs": sfreq,
+        }
