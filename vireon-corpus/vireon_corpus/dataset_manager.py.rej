+    def _load_physionet_bci(self, subject: int, runs: List[int], info: Dict) -> Dict[str, Any]:
+        """Load PhysioNet EEG Motor Movement/Imagery dataset."""
+        raw_files = mne.datasets.eegbci.load_data(subject, runs, update_path=True, verbose=False)
+        raw = mne.io.read_raw_edf(raw_files[0], preload=True, verbose=False)
+        data_arr = raw.get_data()
+        n_channels, n_samples = data_arr.shape
 
+        n_epochs = 40
+        samples_per_epoch = min(250, n_samples // n_epochs)
+        data = data_arr[:, :n_epochs * samples_per_epoch].reshape(
