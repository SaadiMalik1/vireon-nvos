diff a/vireon-verification/literature/test_schirrmeister_2017.py b/vireon-verification/literature/test_schirrmeister_2017.py	(rejected hunks)
@@ -14,11 +14,36 @@ def test_schirrmeister_2017():
     X = rng.normal(0, 1.0, (n_epochs, n_channels, n_samples))
     y = np.array([0, 1] * (n_epochs // 2))
 
-    net = DeepConvNetWrapper(n_classes=2, channels=8, samples=250)
+    # Inject a class-discriminative spectral-spatial pattern so DeepConvNet
+    # has a learnable signal: class 0 → high 10 Hz in channels 0-1; class 1 →
+    # high 20 Hz in channels 2-3.
+    t = np.arange(n_samples) / 250.0
+    alpha = np.sin(2 * np.pi * 10.0 * t)
+    beta = np.sin(2 * np.pi * 20.0 * t)
+    for i in range(n_epochs):
+        if y[i] == 0:
+            X[i, 0:2] += 3.0 * alpha
+            X[i, 2:4] += 0.2 * beta
+        else:
+            X[i, 0:2] += 0.2 * alpha
+            X[i, 2:4] += 3.0 * beta
+
+    net = DeepConvNetWrapper(n_classes=2, channels=8, samples=250, epochs=20)
     net.fit(X, y)
     preds = net.predict(X)
     assert len(preds) == n_epochs
 
+    # Strengthened falsifiable assertion: DeepConvNet must exceed 60% train
+    # accuracy on class-discriminative synthetic EEG (above the 50% chance
+    # level). If the architecture (temporal+spatial conv + BatchNorm + ELU +
+    # MaxPool + Dropout over 4 conv blocks) is correctly wired, it should
+    # overfit the small training set within 20 epochs.
+    train_acc = float(np.mean(preds == y))
+    assert train_acc > 0.60, (
+        f"DeepConvNet train accuracy {train_acc:.2f} not above 0.60 — "
+        "architecture may be missing key components (BN/ELU/MaxPool/Dropout)"
+    )
+
 
 if __name__ == "__main__":
     test_schirrmeister_2017()
