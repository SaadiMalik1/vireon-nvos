-        p_xy = hist_2d / float(np.sum(hist_2d))
-        
-        p_x = np.sum(p_xy, axis=1)
-        p_y = np.sum(p_xy, axis=0)
-        
-        # Outer product of marginals p_x * p_y
-        p_x_p_y = np.outer(p_x, p_y)
