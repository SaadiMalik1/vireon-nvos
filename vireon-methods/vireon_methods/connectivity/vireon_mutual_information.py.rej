+        """Compute mutual information I(X;Y) using Kraskov k-NN estimator.
+
+        Args:
+            x: 1D array of samples from random variable X.
+            y: 1D array of samples from random variable Y (same length as x).
+
+        Returns:
+            Mutual information in nats (natural log).
+        """
+        self._validate(x, y)
+        x = np.asarray(x, dtype=np.float64)
+        y = np.asarray(y, dtype=np.float64)
+        n = len(x)
+
+        from scipy.spatial import cKDTree
+        from scipy.special import digamma
+
+        # Build joint space tree
+        joint = np.column_stack([x, y])
+        tree_joint = cKDTree(joint)
+        distances, _ = tree_joint.query(joint, k=self.k + 1, p=np.inf)
+        eps = distances[:, self.k]
+
+        # Count neighbors in marginal spaces within epsilon_i
+        tree_x = cKDTree(x.reshape(-1, 1))
+        tree_y = cKDTree(y.reshape(-1, 1))
+
+        n_x = np.array([len(tree_x.query_ball_point([x[i]], eps[i], p=np.inf)) - 1
+                        for i in range(n)])
+        n_y = np.array([len(tree_y.query_ball_point([y[i]], eps[i], p=np.inf)) - 1
+                        for i in range(n)])
+
+        # Kraskov estimator 1
+        mi = (digamma(self.k)
+              - np.mean(digamma(n_x + 1) + digamma(n_y + 1))
+              + digamma(n))
+
+        return max(0.0, float(mi))
+
+    def compute_matrix(self, data: np.ndarray) -> np.ndarray:
+        """Compute pairwise MI matrix for multivariate data.
+
+        Args:
+            data: 2D array (n_channels, n_samples).
+
+        Returns:
+            Symmetric (n_channels, n_channels) MI matrix.
+        """
+        if data.ndim != 2:
+            raise ValueError(f"data must be 2D (channels, samples); got {data.shape}")
+        n_ch = data.shape[0]
+        mi_matrix = np.zeros((n_ch, n_ch))
+        for i in range(n_ch):
+            for j in range(i + 1, n_ch):
+                mi = self.compute(data[i], data[j])
+                mi_matrix[i, j] = mi
+                mi_matrix[j, i] = mi
+        return mi_matrix
