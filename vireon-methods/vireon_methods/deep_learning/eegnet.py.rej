+    @property
+    def plugin_id(self) -> str:
+        return "vk:Method:EEGNet"
+
+    @property
+    def plugin_capabilities(self):
+        return {"deep_learning", "classification"}
+
+    def fit(self, X: np.ndarray, y: np.ndarray,
+            epochs: Optional[int] = None,
+            lr: Optional[float] = None,
+            batch_size: Optional[int] = None) -> "EEGNetWrapper":
+        """Fit EEGNet via Adam + CrossEntropyLoss.
+
+        Falls back to a centroid classifier when PyTorch is unavailable.
+        """
+        if not TORCH_AVAILABLE:
+            self._fit_centroid(X, y)
+            return self
+
+        # Resolve effective hyperparameters (kwargs override instance defaults).
+        eff_epochs = int(epochs) if epochs is not None else self.epochs
+        eff_lr = float(lr) if lr is not None else self.lr
+        eff_bs = int(batch_size) if batch_size is not None else self.batch_size
+
+        # Determinism settings (fixes S6 audit finding)
+        torch.manual_seed(self.seed)
+        if torch.cuda.is_available():
+            torch.cuda.manual_seed_all(self.seed)
+            torch.backends.cudnn.deterministic = True
+            torch.backends.cudnn.benchmark = False
+        try:
+            torch.use_deterministic_algorithms(True, warn_only=True)
+        except Exception:
+            pass
+
+        try:
+            from vireon_core.runtime.hardware import get_torch_device, is_gpu_available
+            device = get_torch_device() if (self.use_gpu and is_gpu_available()) else torch.device("cpu")
+        except ImportError:
+            device = torch.device("cpu")
+
+        self.model = EEGNetPyTorch(
+            n_classes=self.n_classes,
+            channels=self.channels,
+            samples=self.samples,
+            dropout_rate=self.dropout_rate,
+            kernel_length=self.kernel_length,
+        ).to(device)
+
+        X_tensor = torch.tensor(np.asarray(X, dtype=np.float32), dtype=torch.float32)
+        if X_tensor.dim() == 3:
+            X_tensor = X_tensor.unsqueeze(1)
+        y_tensor = torch.tensor(np.asarray(y), dtype=torch.long)
+        dataset = TensorDataset(X_tensor, y_tensor)
+
+        g = torch.Generator()
+        g.manual_seed(self.seed)
+        loader = DataLoader(
+            dataset,
+            batch_size=min(eff_bs, len(X)),
+            shuffle=True,
+            generator=g,
+        )
+
+        criterion = nn.CrossEntropyLoss()
+        optimizer = torch.optim.Adam(self.model.parameters(), lr=eff_lr)
+
+        self.model.train()
+        for _ in range(eff_epochs):
+            for batch_X, batch_y in loader:
+                batch_X = batch_X.to(device)
+                batch_y = batch_y.to(device)
+                optimizer.zero_grad()
+                outputs = self.model(batch_X)
+                loss = criterion(outputs, batch_y)
+                loss.backward()
+                optimizer.step()
 
         self._fitted = True
         return self
 
     def predict(self, X: np.ndarray) -> np.ndarray:
