+    # ---- Centroid fallback (no PyTorch available) ----
+
+    def _fit_centroid(self, X: np.ndarray, y: np.ndarray) -> None:
+        feats = self._extract_centroid_features(X)
+        self._centroids = {}
+        for c in np.unique(y):
+            self._centroids[int(c)] = feats[y == c].mean(axis=0)
+        self._fitted = True
+
+    def _predict_centroid(self, X: np.ndarray) -> np.ndarray:
+        if self._centroids is None:
+            raise RuntimeError("EEGNetWrapper not fitted (no centroids).")
+        feats = self._extract_centroid_features(X)
+        preds = []
+        for x in feats:
+            best_c, best_d = None, float('inf')
+            for c, centroid in self._centroids.items():
+                d = float(np.linalg.norm(x - centroid))
+                if d < best_d:
+                    best_d, best_c = d, c
+            preds.append(best_c)
+        return np.array(preds)
+
+    @staticmethod
+    def _extract_centroid_features(X: np.ndarray) -> np.ndarray:
+        """Log-variance per channel — classic BCI feature for EEG decoding."""
+        X = np.asarray(X, dtype=np.float64)
+        if X.ndim == 4 and X.shape[1] == 1:
+            X = X[:, 0, :, :]
+        var = np.var(X, axis=2)  # (n_epochs, n_channels)
+        return np.log(np.maximum(var, 1e-12))
