+class EEGNetPyTorch(nn.Module if TORCH_AVAILABLE else object):
+    """EEGNet-2,2 (Lawhern 2018 Figure 1).
+
+    Architecture:
+        Input: (B, 1, C, T)
+        Conv2D(1, F1=8, kernel=(1, 64), padding=(0, 32))  # temporal
+        BatchNorm2d(8)
+        Conv2D(8, F2=16, kernel=(C, 1), groups=8)         # depthwise spatial
+        BatchNorm2d(16)
+        ELU()
+        AvgPool2d((1, 4))                                 # downsample 4x
+        Dropout(0.25)
+        Conv2D(16, 16, kernel=(1, 16), padding=(0, 8), groups=16)  # separable
+        Conv2D(16, 16, kernel=(1, 1))                     # pointwise
+        BatchNorm2d(16)
+        ELU()
+        AvgPool2d((1, 8))                                 # downsample 8x
+        Dropout(0.25)
+        Flatten()
+        Linear(16 * (T // 32), n_classes)
+    """
+
+    def __init__(self, n_classes: int = 2, channels: int = 8, samples: int = 250,
+                 f1: int = 8, d: int = 2, f2: int = 16,
+                 dropout_rate: float = 0.25, kernel_length: int = 64):
+        if not TORCH_AVAILABLE:
+            raise ImportError("PyTorch not available")
+        super().__init__()
+        self.n_classes = n_classes
+        self.channels = channels
+        self.samples = samples
+        self.f1 = f1
+        self.f2 = f1 * d
+
+        # Block 1: Temporal + Depthwise Spatial
+        self.conv1 = nn.Conv2d(1, f1, (1, kernel_length), padding=(0, kernel_length // 2), bias=False)
+        self.bn1 = nn.BatchNorm2d(f1)
+        self.depthwise = nn.Conv2d(f1, f1 * d, (channels, 1), groups=f1, bias=False)
+        self.bn2 = nn.BatchNorm2d(f1 * d)
+        self.elu1 = nn.ELU()
+        self.pool1 = nn.AvgPool2d((1, 4))
+        self.drop1 = nn.Dropout(dropout_rate)
+
+        # Block 2: Separable Conv
+        self.sep_conv = nn.Conv2d(f1 * d, f1 * d, (1, 16), padding=(0, 8), groups=f1 * d, bias=False)
+        self.point_conv = nn.Conv2d(f1 * d, f2, (1, 1), bias=False)
+        self.bn3 = nn.BatchNorm2d(f2)
+        self.elu2 = nn.ELU()
+        self.pool2 = nn.AvgPool2d((1, 8))
+        self.drop2 = nn.Dropout(dropout_rate)
+
+        # Classification head
+        reduced_samples = samples // 32
+        self.fc = nn.Linear(f2 * reduced_samples, n_classes)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        if x.dim() == 3:
+            x = x.unsqueeze(1)
+        # Block 1
+        x = self.conv1(x)
+        x = self.bn1(x)
+        x = self.depthwise(x)
+        x = self.bn2(x)
+        x = self.elu1(x)
+        x = self.pool1(x)
+        x = self.drop1(x)
+        # Block 2
+        x = self.sep_conv(x)
+        x = self.point_conv(x)
+        x = self.bn3(x)
+        x = self.elu2(x)
+        x = self.pool2(x)
+        x = self.drop2(x)
+        # Classification
+        x = x.view(x.size(0), -1)
+        x = self.fc(x)
+        return x
+
