-"""Filter Bank Common Spatial Pattern (FBCSP) Spatial Filter.
+"""Filter Bank Common Spatial Patterns (Blankertz 2008).
 
-Reference: Ang, K. K., Chin, Z. Y., Zhang, H., & Guan, C. (2012). Filter bank common spatial pattern (FBCSP)
-in brain-computer interface. Proceedings of the International Joint Conference on Neural Networks, 2390-2397.
-DOI: 10.1109/IJCNN.2012.6252486
+FIXED in playbook dx — was broken (no band-pass filtering applied per band).
+Now applies _BandpassFilter (scipy.signal.butter + filtfilt) per band before each CSP.
 """
 import numpy as np
+from typing import List, Tuple, Optional
+from scipy.signal import butter, filtfilt
 from vireon_methods.spatial.vireon_csp import VireonCSP
 
 
+class _BandpassFilter:
+    """Simple band-pass filter using scipy.signal.butter + filtfilt."""
+
+    def __init__(self, fs: float, order: int, low: float, high: float):
+        nyq = fs / 2.0
+        self.b, self.a = butter(order, [low / nyq, high / nyq], btype="bandpass")
+
+    def apply(self, signal: np.ndarray) -> np.ndarray:
+        """Apply filter along last axis."""
+        return filtfilt(self.b, self.a, signal, axis=-1)
+
+
 class VireonFBCSP:
