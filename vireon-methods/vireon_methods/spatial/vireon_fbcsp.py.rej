-    def fit_transform(self, X: np.ndarray, y: np.ndarray) -> np.ndarray:
-        """Extract multi-band CSP features concatenated across filter banks."""
+    @property
+    def plugin_capabilities(self):
+        return {"spatial_filtering", "feature_extraction"}
+
+    def _validate_input(self, X: np.ndarray, fs: float) -> None:
+        if X.ndim != 3:
+            raise ValueError(f"X must be 3D (epochs, channels, samples); got shape {X.shape}")
+        if np.any(np.isnan(X)) or np.any(np.isinf(X)):
+            raise ValueError("X contains NaN or Inf values")
+        for low, high in self.bands:
+            if low >= high:
+                raise ValueError(f"Band ({low}, {high}) has low >= high")
+            if high >= fs / 2:
+                raise ValueError(f"Band high {high} Hz exceeds Nyquist {fs/2} Hz")
+
+    def fit(self, X: np.ndarray, y: np.ndarray, fs: float) -> "VireonFBCSP":
+        """Fit FBCSP. X: (epochs, channels, samples). y: labels. fs: sample rate."""
+        self._fs = fs
+        self._validate_input(X, fs)
+
+        self._filters = []
+        self._csps = []
+        for (low, high) in self.bands:
+            filt = _BandpassFilter(
+                fs=fs, order=self.filter_order,
+                low=low, high=high,
+            )
+            X_band = np.array([filt.apply(epoch) for epoch in X])
+            csp = VireonCSP(n_components=self.n_components)
+            csp.fit(X_band, y)
+            self._filters.append(filt)
+            self._csps.append(csp)
+
+        self._fitted = True
+        return self
+
