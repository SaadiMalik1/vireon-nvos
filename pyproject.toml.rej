diff a/pyproject.toml b/pyproject.toml	(rejected hunks)
@@ -4,7 +4,7 @@ build-backend = "setuptools.build_meta"
 
 [project]
 name = "vireon-nvos"
-version = "1.0.3"
+version = "1.2.0"
 description = "VIREON — Neurotechnology Validation Operating System"
 readme = "README.md"
 license = {text = "MIT"}
@@ -104,3 +104,37 @@ pythonpath = [
     "vireon-api",
     "vireon-verification"
 ]
+
+[tool.ruff]
+line-length = 100
+target-version = "py310"
+extend-select = ["E", "W", "F", "I", "B", "C4", "UP", "RUF", "T20", "SIM"]
+ignore = ["E501", "B008"]
+
+[tool.ruff.format]
+quote-style = "double"
+
+[tool.mypy]
+python_version = "3.10"
+warn_return_any = true
+warn_unused_configs = true
+disallow_untyped_defs = false
+ignore_missing_imports = true
+exclude = ["site/", "build/", "dist/"]
+
+[[tool.mypy.overrides]]
+module = ["vireon_core.*", "vireon_methods.*"]
+disallow_untyped_defs = true
+
+[tool.coverage.run]
+source = ["vireon_core", "vireon_methods", "vireon_validation", "vireon_evidence"]
+omit = ["*/tests/*", "*/test_*.py"]
+
+[tool.coverage.report]
+exclude_lines = [
+    "pragma: no cover",
+    "def __repr__",
+    "raise NotImplementedError",
+    "if __name__ == .__main__.:",
+    "pass",
+]
